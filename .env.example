# ==========================================
# ZaminTahlil v2 - Muhit Sozlamalari (.env)
# ==========================================

# 1. Google Earth Engine (GEE)
# Asosiy GEE loyihasi
GEE_PROJECT_PRIMARY=
GEE_KEY_FILE_PRIMARY=

# Zaxira GEE loyihasi (kvota yoki ruxsat xatosida avtomatik o'tiladi)
GEE_PROJECT_SECONDARY=
GEE_KEY_FILE_SECONDARY=

# 2. Sun'iy Intellekt (AI) Provayderlari
# Standart provayder: openrouter, openai, ollama
AI_PROVIDER=openrouter
AI_MODEL=openrouter/free

# API kalitlari
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# 3. Quvur va Operatsion Sozlamalar
LOOKBACK_DAYS=10
WEATHER_PAST_DAYS=5
WEATHER_FORECAST_DAYS=5
MAX_SCENE_CLOUD_PCT=40
CLOUD_SCORE_THRESHOLD=0.60
S1_ORBIT_PASS=BOTH
ANALYSIS_RESOLUTION_M=10
MAX_AOI_KM2=100
GEE_REQUEST_TIMEOUT_S=60
GEE_MAX_RETRIES=3
GEE_MAX_CONCURRENCY=6
AI_HISTORY_SIZE=10
